{
  "name": "agents-plugin-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Structural + behavioral tests for the argyle-labs/agents roster (ported from orca).",
  "scripts": {
    "gen:summary": "node scripts/generate-summary.mjs",
    "check:summary": "node scripts/generate-summary.mjs --check",
    "test": "vitest run --reporter=verbose --project=structural",
    "test:structural": "vitest run --reporter=verbose --project=structural",
    "test:behavioral": "vitest run --reporter=verbose --project=behavioral",
    "test:local": "vitest run --reporter=verbose --project=local",
    "test:local:ollama": "LOCAL_LLM_URL=http://localhost:11434/v1 vitest run --reporter=verbose --project=local",
    "test:all": "vitest run --reporter=verbose --project=structural --project=behavioral",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
